#!/bin/bash
# Run in the native graphics builder with networking disabled and no devices.
set -euo pipefail
cd /work/swiftshader
test "$(git rev-parse HEAD)" = 9759b180cf5b6687afc1f231b1b9fa230da1b261
git apply --reverse --check /opt/graphics/swiftshader-jit-mmap.patch
mkdir -p /work/graphics-records
git diff --binary > /work/graphics-records/applied.patch
cp /etc/upstream-graphics.lock.json /work/graphics-records/source.lock.json
dpkg-query -W '-f=${binary:Package}\t${Version}\n' > /work/graphics-records/builder-packages.txt
cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_VULKAN=OFF -DBUILD_TESTS=OFF -DBUILD_SAMPLES=OFF -DUSE_GROUP_SOURCES=OFF
cmake --build build --target libEGL libGLESv2 libGLES_CM --parallel 8
for library in libEGL.so libGLESv2.so libGLES_CM.so; do
    test -s "build/$library"
done
printf '%s\n' 'Source graphics build complete; runtime validation pending.'
